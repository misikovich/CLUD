# Installer tooling (uv, its Python, Textual) and download cache - fetched on first run
/.tools/
/.cache/
__pycache__/

# Old build-script output
/CLUD/
/.downloads/

# Never commit a live config: it holds the login (.credentials.json) and account info
.credentials.json
.claude.json

# Preview renders (README images in docs/ are kept)
*.png
!/docs/*.png

# Linux test VM (tests/linux-vm.sh)
/.vm/

# Windows test VM (tests/windows-vm.sh)
/.vm-win/

# Raspberry Pi OS test VM (tests/pi-vm.sh)
/.vm-pi/
