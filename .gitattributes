# Windows scripts must keep CRLF (cmd.exe misparses LF-only batch files), whatever OS clones this
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.inf text eol=crlf
*.cs  text eol=crlf
*.txt text eol=crlf

# ...and the macOS/Linux launcher must keep LF, or sh chokes on the \r
*.sh  text eol=lf
*.py  text eol=lf
*.md  text eol=lf
*.desktop text eol=lf
*.command text eol=lf

*.ico binary
*.exe binary
